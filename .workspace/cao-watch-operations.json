{
  "operations": [
    {
      "argv": [
        "wsx",
        "cao",
        "observe",
        "--live"
      ],
      "description": "Read authorized session hook-derived observation; not callback acceptance.",
      "effects": [
        "read-cao-session-observation"
      ],
      "evidence_limits": [
        "Observation is not delivery or review acceptance.",
        "Unknown or degraded coverage is not a successful run."
      ],
      "executor": "local",
      "id": "cao.observe",
      "parameters": [
        {
          "arg_map": {
            "flag": "--session",
            "style": "flag"
          },
          "max_length": 64,
          "name": "session",
          "type": "string"
        }
      ],
      "repository": "project",
      "resources": [],
      "result_adapter": "exit-code",
      "timeout_seconds": 30,
      "version": 1
    },
    {
      "argv": [
        "shasum",
        "-a",
        "256",
        "--"
      ],
      "description": "Measure one file's SHA-256 (protocol C4); evidence of content, not of delivery.",
      "effects": [
        "read-file"
      ],
      "evidence_limits": [
        "A hash proves content identity only; routing and acceptance still follow C4/C5.",
        "The path is not scope-checked; hashing is as wide as the pane's read access."
      ],
      "executor": "local",
      "id": "artifact.sha256",
      "parameters": [
        {
          "arg_map": {
            "style": "positional"
          },
          "max_length": 512,
          "name": "path",
          "type": "string"
        }
      ],
      "repository": "project",
      "resources": [],
      "result_adapter": "exit-code",
      "timeout_seconds": 30,
      "version": 1
    },
    {
      "argv": [
        "wsx",
        "cao",
        "human-ask"
      ],
      "description": "Ask the human one question through Slack (protocol C12) and return its question_id at once; then end your turn. The decision arrives later as a HUMAN-ANSWER notice; read it with human.read.",
      "effects": [
        "ask-human-question",
        "queue-cao-inbox-notice"
      ],
      "env_allowlist": [
        "CAO_TERMINAL_ID"
      ],
      "evidence_limits": [
        "Asked is not answered: the decision is only what human.read reports for the question_id.",
        "Nothing said in a chat is a decision; only the human's pick of an option is."
      ],
      "executor": "local",
      "id": "human.ask",
      "parameters": [
        {
          "arg_map": {
            "flag": "--session",
            "style": "flag"
          },
          "max_length": 64,
          "name": "session",
          "type": "string"
        },
        {
          "arg_map": {
            "flag": "--question",
            "style": "flag_equals"
          },
          "max_length": 240,
          "name": "question",
          "type": "string"
        },
        {
          "arg_map": {
            "flag": "--options",
            "style": "flag_equals"
          },
          "default": "",
          "description": "The fixed choices, separated by '|' (at most 8, each at most 32 characters); empty for free text.",
          "max_length": 300,
          "name": "options",
          "type": "string"
        },
        {
          "arg_map": {
            "flag": "--context",
            "style": "flag_equals"
          },
          "default": "",
          "max_length": 1000,
          "name": "context",
          "type": "string"
        }
      ],
      "repository": "project",
      "resources": [],
      "result_adapter": "exit-code",
      "timeout_seconds": 120,
      "version": 1
    },
    {
      "argv": [
        "wsx",
        "cao",
        "human-read"
      ],
      "description": "Read one question's recorded state, decision and chat (protocol C12); the only source of a decision.",
      "effects": [
        "read-human-question"
      ],
      "evidence_limits": [
        "A decision decides that question once; it grants nothing beyond it."
      ],
      "executor": "local",
      "id": "human.read",
      "parameters": [
        {
          "arg_map": {
            "flag": "--session",
            "style": "flag"
          },
          "max_length": 64,
          "name": "session",
          "type": "string"
        },
        {
          "arg_map": {
            "flag": "--question-id",
            "style": "flag_equals"
          },
          "max_length": 64,
          "name": "question_id",
          "type": "string"
        }
      ],
      "repository": "project",
      "resources": [],
      "result_adapter": "exit-code",
      "timeout_seconds": 30,
      "version": 1
    },
    {
      "argv": [
        "wsx",
        "cao",
        "human-reply"
      ],
      "description": "Post your reply into a human chat (protocol C12), or end the chat with end=true.",
      "effects": [
        "post-human-chat-reply"
      ],
      "evidence_limits": [
        "Posted is not read: the human's next message arrives as a HUMAN-CHAT notice.",
        "Nothing said in a chat is a decision; only the human's pick of an option is."
      ],
      "executor": "local",
      "id": "human.reply",
      "parameters": [
        {
          "arg_map": {
            "flag": "--session",
            "style": "flag"
          },
          "max_length": 64,
          "name": "session",
          "type": "string"
        },
        {
          "arg_map": {
            "flag": "--question-id",
            "style": "flag_equals"
          },
          "max_length": 64,
          "name": "question_id",
          "type": "string"
        },
        {
          "arg_map": {
            "flag": "--text",
            "style": "flag_equals"
          },
          "default": "",
          "max_length": 2000,
          "name": "text",
          "type": "string"
        },
        {
          "arg_map": {
            "style": "switch",
            "when_true": [
              "--end"
            ]
          },
          "default": false,
          "name": "end",
          "type": "boolean"
        }
      ],
      "repository": "project",
      "resources": [],
      "result_adapter": "exit-code",
      "timeout_seconds": 30,
      "version": 1
    }
  ],
  "schema_version": 1
}
