# Copy to apps/web/.env.local (gitignored) and fill in the staging project's values from
# Supabase: Connect, or Settings → Data API and Settings → API Keys.
# Both are public by design: anything prefixed VITE_ ships to the browser, so never put a
# secret here.
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
