# Copy to apps/web/.env.local (gitignored) and fill in the staging project's values from
# Supabase (ootp-staging): the Connect button, or Settings → Data API and Settings → API Keys.
# Both are public by design: anything prefixed VITE_ ships to the browser, so never put a
# secret here. `pnpm check-setup` checks this file.
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Later, for the advisor function (Phase 5). Server-only, so no VITE_ prefix:
# GEMINI_API_KEY=
# ADVISOR_DAILY_LIMIT=
