{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    /* No DOM and no Node: core is pure TypeScript. "types": [] only stops automatic
       @types loading; a dependency that references Node types still brings them in,
       so eslint.config.js also bans Node and DOM globals in core. */
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
